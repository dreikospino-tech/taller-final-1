class Producto:

  def __init__(self, nombre, precio_inicial):
    self.__nombre = nombre
    self.__precios_historicos = []
 
    self.precio = precio_inicial

  @property
  def precio(self):

    if self.__precios_historicos:
      return self.__precios_historicos[-1]
    return 0

  @precio.setter
  def precio(self, nuevo_precio):

    if 0 <= nuevo_precio <= 10000:
      self.__precios_historicos.append(nuevo_precio)
      print(f"Precio ${nuevo_precio} registrado exitosamente para {self.__nombre}.")
    else:
      print(
          f"Advertencia: El precio ${nuevo_precio} no es válido. Debe estar"
          " entre $0 y $10,000. No se guardó."
      )

  def calcular_precio_promedio(self):
    if not self.__precios_historicos:
      return 0
    return sum(self.__precios_historicos) / len(self.__precios_historicos)

  def ver_historial(self):
    return self.__precios_historicos


print("--- PRUEBA EJERCICIO 1 ---")
p = Producto("Laptop", 5000)
p.precio = 5500  
p.precio = 12000  
p.precio = -500  

print("Historial de precios:", p.ver_historial())
print(f"Precio promedio: ${p.calcular_precio_promedio():.2f}\n")
