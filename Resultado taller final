class Envio:
  def __init__(self, peso_kg, distancia_km):
    self.peso_kg = peso_kg
    self.distancia_km = distancia_km

  def calcular_costo(self, monto_base):
    return monto_base



class EnvioEstandar(Envio):
  def calcular_costo(self, monto_base):
    return monto_base * 1.05



class EnvioExpress(Envio):
  def calcular_costo(self, monto_base):
    return monto_base * 1.15


print("--- PRUEBA EJERCICIO 2 ---")

envios = [
    EnvioEstandar(peso_kg=2.5, distancia_km=50),
    EnvioExpress(peso_kg=1.2, distancia_km=120),
    EnvioEstandar(peso_kg=5.0, distancia_km=15),
    EnvioExpress(peso_kg=3.0, distancia_km=300),
]

monto_base_prueba = 100.0  


for i, envio in enumerate(envios, 1):
  tipo = (
      "Estándar" if isinstance(envio, EnvioEstandar) else "Express"
  )
  costo_final = envio.calcular_costo(monto_base_prueba)
  print(
      f"Envío {i} ({tipo}) -> Peso: {envio.peso_kg}kg, Distancia:"
      f" {envio.distancia_km}km | Costo Total: ${costo_final:.2f}"
  )
